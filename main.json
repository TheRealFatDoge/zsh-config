{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "session",
          "style": "powerline",
          "background": "#61AFEF",
          "foreground": "#000000",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b0",
          "template": " {{ .UserName }}@{{ .HostName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "background": "#C678DD",
          "foreground": "#000000",
          "powerline_symbol": "\ue0b0",
          "template": " {{ .Path }} ",
          "options": {
            "style": "full"
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "background": "#95FFA4",
          "foreground": "#000000",
          "powerline_symbol": "\ue0b0",
          "template": " {{ .HEAD }} "
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "time",
          "style": "powerline",
          "foreground": "#61AFEF",
          "template": " {{ .CurrentDate | date .Format }} ",
          "options": {
            "time_format": "15:04:05"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#BB9AF7",
          "template": "❯"
        }
      ]
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#BB9AF7",
    "template": "❯ "
  },
  "secondary_prompt": {
    "background": "transparent",
    "foreground": "#BB9AF7",
    "template": "❯ ",
    "multiline_keepprompt": true
  }
}

